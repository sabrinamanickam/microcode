#!/bin/sh

version="$1"
shorthostname="$2"
abi="$3"
startdate="$4"
o="$5"
p="$6"
implementationdir="$7"
compilerword="$8"
opi="$9"
language="${10}"

for obj in try *.o
do
  [ -f "$obj" ] || continue
  size "$obj"
done \
| while read text data bss dec hex fn
do
  [ "$text" = "text" ] && continue
  echo "$version $shorthostname $abi $startdate $o $p objsize $implementationdir $compilerword $text $data $bss $fn" >&5
done

# XXX: support analysis of C++ namespace mangling
if [ "$language" = c ]
then
  for obj in *.o
  do
    [ -f "$obj" ] || continue
    nm -pP --defined-only "$obj" \
    | while read symbol type etc
    do
      case "$type" in
        b*|d*|r*|t*) continue
          ;;
      esac
      case "$symbol" in
        $opi) continue ;;
        _$opi) continue ;;
        ${opi}_*) continue ;;
        _${opi}_*) continue ;;
        '__x86.get_pc_thunk.'*) continue ;;
        *) echo "$version $shorthostname $abi $startdate $o $p namespace $implementationdir $compilerword $obj $symbol $type" >&5
          ;;
      esac
    done
  done
fi
