\@writefile{toc}{\contentsline {paragraph}{Three accumulators that never share the carry flag.}{16}{section*.37}\protected@file@percent }
\newlabel{lst:c25519-mac}{{4}{16}{The fused multiply--accumulate--carry motif, taken from the squaring kernel's first output limb. \texttt {TMP0} is the low accumulator, \texttt {R8} the high accumulator, \texttt {TMP9} the running sum of accumulation carries, \texttt {TMP15} the transient \texttt {SETCC} carry. The multiply writes its low half into the operand register (read on the same line) and its high half into \texttt {RCX} (added in later)}{lstlisting.4}{}}
\newlabel{lst:c25519-mac@cref}{{[listing][4][]4}{[1][16][]16}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {4}The fused multiply--accumulate--carry motif, taken from the squaring kernel's first output limb. \texttt  {TMP0} is the low accumulator, \texttt  {R8} the high accumulator, \texttt  {TMP9} the running sum of accumulation carries, \texttt  {TMP15} the transient \texttt  {SETCC} carry. The multiply writes its low half into the operand register (read on the same line) and its high half into \texttt  {RCX} (added in later).}{16}{lstlisting.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Resolving a limb and linking to the next.}{16}{section*.38}\protected@file@percent }
\newlabel{lst:c25519-carry}{{5}{17}{Limb resolution and the inter-limb link. Because $2^{64}=2^{51}\cdot 2^{13}$, the carry out of a limb splits into a 13-bit low part (\texttt {TMP8}) and a left-shifted high part (\texttt {TMP1}) whose bit ranges do not overlap, so the link that opens the next limb is an \texttt {OR}, not an addition}{lstlisting.5}{}}
\newlabel{lst:c25519-carry@cref}{{[listing][5][]5}{[1][17][]17}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {5}Limb resolution and the inter-limb link. Because $2^{64}=2^{51}\cdot 2^{13}$, the carry out of a limb splits into a 13-bit low part (\texttt  {TMP8}) and a left-shifted high part (\texttt  {TMP1}) whose bit ranges do not overlap, so the link that opens the next limb is an \texttt  {OR}, not an addition.}{17}{lstlisting.5}\protected@file@percent }
